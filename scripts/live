#!/bin/sh
# Usage: scripts/live dev|stable|<branch>|status     (<branch>: test an unfinalized feat/* before it lands)
# Switches what the main checkout (the running/deployed copy) has checked out.
. "$(dirname "$0")/_lib.sh"
cd "$LIVE"
case "${1:-status}" in
  status) ;;
  *)
    git rev-parse --verify -q "refs/heads/$1" >/dev/null || die "usage: scripts/live dev|stable|<branch>|status"
    [ -z "$(git status --porcelain)" ] || die "main checkout has uncommitted changes"
    if [ "$1" = stable ]; then git switch stable; else git switch --detach "$1"; fi ;;
esac
# Some apps cache code across a branch switch; workflow.reloadCmd (git config) restarts them.
if [ "${1:-status}" != status ] && reload=$(git config workflow.reloadCmd); then
  echo "reloading: $reload"; sh -c "$reload" >/dev/null 2>&1 || echo "warning: reload command failed" >&2
fi
echo "live: $(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)  (dev=$(git rev-parse --short dev) stable=$(git rev-parse --short stable))"
